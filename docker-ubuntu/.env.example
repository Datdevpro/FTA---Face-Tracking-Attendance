# FTA Docker configuration for Jetson Nano

APP_NAME=FTA - Face Time Attendance
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/fta.db
DB_ECHO=false

# deploy.sh replaces this value when it creates docker-ubuntu/.env.
JWT_SECRET_KEY=replace-me-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# USB webcam. For RTSP, replace 0 with the full RTSP URL and remove the
# devices section from docker-compose.yml if no local camera is used.
CAMERA_SOURCE=0
# Comment out CAMERA_SOURCE=0 above to enable RTSP:
# CAMERA_SOURCE="rtsp://username:password@192.168.1.100:554/stream1"
RTSP_OPEN_TIMEOUT_MS=5000
# Camera Feed dropdown: Webcam = 0; IMOU URLs:
CAMERA_IMOU_ROTATE_RTSP=""
CAMERA_IMOU_FIXED_RTSP=""
RTSP_READ_TIMEOUT_MS=5000
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
STREAM_PREVIEW_FPS=10

# The Nano CPU is limited; process recognition less frequently than desktop.
RECOGNITION_INTERVAL_FRAMES=8
RECOGNITION_MAX_STALE_MS=1500

FACE_MODEL_NAME=buffalo_l
FACE_ONNX_PROVIDER=cpu
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.4
FACE_MIN_QUALITY=0.3
FACE_REGISTRATION_COUNT=3


WORK_START_TIME=08:00
WORK_END_TIME=17:00
LATE_THRESHOLD_MINUTES=15
CHECK_OUT_WINDOW_MINUTES=15
ATTENDANCE_PENDING_STATE_PATH=./data/pending_checkouts.json

FACE_IMAGES_DIR=./data/face_images
FAISS_INDEX_DIR=./data/faiss_index
MODELS_DIR=./data/models
ATTENDANCE_SNAPSHOTS_DIR=./data/snapshots
