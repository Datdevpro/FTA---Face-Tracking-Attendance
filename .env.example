# ============================================
# FTA - Face Time Attendance System
# Environment Configuration
# ============================================

# --- Application ---
APP_NAME=FTA - Face Time Attendance
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=1900

# --- Database ---
# PostgreSQL: postgresql://user:password@host:port/dbname
# SQLite: sqlite:///./data/fta.db
DATABASE_URL=sqlite:///./data/fta.db
# PostgreSQL option for later:
# DATABASE_URL=postgresql://fta_user:fta_password@localhost:5432/fta_db
DB_ECHO=false

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Camera ---
# USB camera index (0, 1, 2...) or RTSP URL
CAMERA_SOURCE=0
# RTSP alternative (comment out CAMERA_SOURCE=0 above before enabling):
# CAMERA_SOURCE="rtsp://username:password@192.168.1.100:554/stream1"
# Camera Feed dropdown: Webcam = 0; enter each IMOU URL below.
CAMERA_IMOU_ROTATE_RTSP=""
CAMERA_IMOU_FIXED_RTSP=""
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
STREAM_PREVIEW_FPS=15
RECOGNITION_INTERVAL_FRAMES=5
RECOGNITION_MAX_STALE_MS=1000

# --- Welcome audio through go2rtc (auto-started by Windows launch scripts) ---
CAMERA_AUDIO_ENABLED=true
CAMERA_AUDIO_GO2RTC_URL=http://127.0.0.1:1984
CAMERA_AUDIO_STREAM=imou
# Windows local setup; on Linux use ffmpeg instead.
CAMERA_AUDIO_FFMPEG_BIN=./camera_test/ffmpeg.exe
CAMERA_AUDIO_DIR=./camera_test/welcome_audio
# Leave empty when FTA and go2rtc see the same absolute file paths.
CAMERA_AUDIO_GO2RTC_DIR=
CAMERA_AUDIO_QUEUE_SIZE=5

# VieNeu runs separately; fallback: Edge TTS -> gTTS. Use edge to switch back.
TTS_PROVIDER=vieneu
VIENEU_URL=http://127.0.0.1:1985
VIENEU_VOICE=Mai Anh
VIENEU_THREADS=2
VIENEU_TIMEOUT_SECONDS=20
EMPLOYEE_GREETING_DIR=./data/employee_greetings
# Same directory as seen by go2rtc; leave empty for this Windows setup.
EMPLOYEE_GREETING_GO2RTC_DIR=

# --- Face Recognition ---
# InsightFace model name (buffalo_l, buffalo_s, buffalo_sc)
FACE_MODEL_NAME=buffalo_l
# ONNX provider: cuda, cpu, or auto
FACE_ONNX_PROVIDER=cpu
# Detection confidence threshold (0.0 - 1.0)
FACE_DETECTION_THRESHOLD=0.5
# Recognition distance threshold (lower = stricter matching)
FACE_RECOGNITION_THRESHOLD=0.4
# Minimum face quality score for registration
FACE_MIN_QUALITY=0.3
# Number of face images required for registration
FACE_REGISTRATION_COUNT=3

# --- Attendance ---
# Work schedule
WORK_START_TIME=08:00
WORK_END_TIME=17:00
LATE_THRESHOLD_MINUTES=15
# A checkout candidate is captured from WORK_END_TIME minus this value until WORK_END_TIME.
CHECK_OUT_WINDOW_MINUTES=15
ATTENDANCE_PENDING_STATE_PATH=./data/pending_checkouts.json

# --- File Storage ---
FACE_IMAGES_DIR=./data/face_images
FAISS_INDEX_DIR=./data/faiss_index
MODELS_DIR=./data/models
ATTENDANCE_SNAPSHOTS_DIR=./data/snapshots

# --- Logging ---
LOG_LEVEL=INFO
