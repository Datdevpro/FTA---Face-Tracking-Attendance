# ============================================
# FTA - Docker Configuration for Windows
# ============================================

# --- Application ---
APP_NAME=FTA - Face Time Attendance
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
# IANA timezone used by attendance dates and times inside the container.
TZ=Asia/Ho_Chi_Minh

# --- Database ---
# SQLite local database inside mounted volume (/app/data/fta.db)
DATABASE_URL=sqlite:///./data/fta.db
DB_ECHO=false

# --- JWT Authentication ---
JWT_SECRET_KEY=fta-windows-docker-secret-key-replace-in-prod-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Camera Settings ---
# On Windows Docker:
# 1. Recommended: let the browser capture the Windows webcam:
#    CAMERA_SOURCE=browser
# 2. To use your phone as an IP Camera (DroidCam / IP Webcam):
#    CAMERA_SOURCE=http://192.168.1.50:8080/video
# 3. To use RTSP Camera:
#    CAMERA_SOURCE=rtsp://admin:pass@192.168.1.100:554/stream1
# 4. If you passed USB Webcam via usbipd-win:
#    CAMERA_SOURCE=0
CAMERA_SOURCE=browser
# Comment out CAMERA_SOURCE=browser above to enable the RTSP example:
# CAMERA_SOURCE="rtsp://username:password@192.168.1.100:554/stream1"
RTSP_OPEN_TIMEOUT_MS=5000
# Camera Feed dropdown: Webcam = 0 (backend USB); IMOU URLs:
CAMERA_IMOU_ROTATE_RTSP=""
CAMERA_IMOU_FIXED_RTSP=""
RTSP_READ_TIMEOUT_MS=5000
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
STREAM_PREVIEW_FPS=15
RECOGNITION_INTERVAL_FRAMES=3
RECOGNITION_MAX_STALE_MS=1000

# --- Face Recognition ---
FACE_MODEL_NAME=buffalo_l
# Set to 'cpu' for standard CPU inference, or 'cuda' if using NVIDIA GPU with Docker
FACE_ONNX_PROVIDER=cpu
FACE_DETECTION_THRESHOLD=0.6
FACE_RECOGNITION_THRESHOLD=0.6
FACE_MIN_QUALITY=0.3
FACE_REGISTRATION_COUNT=3

# --- Anti-Spoofing ---
ANTI_SPOOFING_ENABLED=true
ANTI_SPOOFING_MODEL_PATH=./data/models/anti_spoofing/AntiSpoofing_bin_1.5_128.onnx
ANTI_SPOOFING_PROVIDER=cpu
ANTI_SPOOFING_THRESHOLD=0.7
ANTI_SPOOFING_CROP_SCALE=1.5
ANTI_SPOOFING_INTERVAL_FRAMES=5

# --- Attendance Schedule ---
WORK_START_TIME=08:00
WORK_END_TIME=17:00
LATE_THRESHOLD_MINUTES=15
CHECK_OUT_WINDOW_MINUTES=15
ATTENDANCE_PENDING_STATE_PATH=./data/pending_checkouts.json

# --- Storage Directories ---
FACE_IMAGES_DIR=./data/face_images
FAISS_INDEX_DIR=./data/faiss_index
MODELS_DIR=./data/models
ATTENDANCE_SNAPSHOTS_DIR=./data/snapshots

# --- Logging ---
LOG_LEVEL=INFO
